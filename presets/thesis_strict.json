{
  "name": "严格学位论文规范",
  "page_setup": {
    "paper_size": "A4",
    "margin": {
      "top_cm": 2.5,
      "bottom_cm": 2.0,
      "left_cm": 2.0,
      "right_cm": 2.0
    },
    "columns": {
      "count": 1,
      "space_cm": 0.0,
      "equal_width": true,
      "separator": false
    }
  },
  "styles": {
    "normal": {
      "font_cn": "宋体",
      "font_en": "Times New Roman",
      "size_pt": 12.0,
      "bold": false,
      "italic": false,
      "alignment": "justify",
      "first_line_indent_cm": 0.85,
      "left_indent_cm": 0.0,
      "hanging_indent_cm": 0.0,
      "line_spacing_mode": "exact",
      "line_spacing_pt": 20.0,
      "space_before_pt": 0.0,
      "space_after_pt": 0.0,
      "widow_control": true
    },
    "heading1": {
      "font_cn": "黑体",
      "font_en": "Times New Roman",
      "size_pt": 15.0,
      "bold": false,
      "italic": false,
      "alignment": "center",
      "first_line_indent_cm": 0.0,
      "left_indent_cm": 0.0,
      "hanging_indent_cm": 0.0,
      "line_spacing_mode": "exact",
      "line_spacing_pt": 20.0,
      "space_before_pt": 40.0,
      "space_after_pt": 20.0,
      "keep_with_next": true,
      "page_break_before": true
    },
    "heading2": {
      "font_cn": "黑体",
      "font_en": "Times New Roman",
      "size_pt": 14.0,
      "bold": false,
      "italic": false,
      "alignment": "left",
      "first_line_indent_cm": 0.0,
      "left_indent_cm": 0.0,
      "hanging_indent_cm": 0.0,
      "line_spacing_mode": "exact",
      "line_spacing_pt": 20.0,
      "space_before_pt": 24.0,
      "space_after_pt": 6.0,
      "keep_with_next": true
    },
    "heading3": {
      "font_cn": "黑体",
      "font_en": "Times New Roman",
      "size_pt": 12.0,
      "bold": false,
      "italic": false,
      "alignment": "left",
      "first_line_indent_cm": 0.0,
      "left_indent_cm": 0.0,
      "hanging_indent_cm": 0.0,
      "line_spacing_mode": "exact",
      "line_spacing_pt": 20.0,
      "space_before_pt": 12.0,
      "space_after_pt": 6.0,
      "keep_with_next": true
    },
    "code_block": {
      "font_cn": "宋体",
      "font_en": "Consolas",
      "size_pt": 10.5,
      "bold": false,
      "italic": false,
      "alignment": "left",
      "first_line_indent_cm": 0.0,
      "left_indent_cm": 0.0,
      "line_spacing_mode": "exact",
      "line_spacing_pt": 20.0,
      "space_before_pt": 0.0,
      "space_after_pt": 0.0
    },
    "references_body": {
      "font_cn": "宋体",
      "font_en": "Times New Roman",
      "size_pt": 12.0,
      "bold": false,
      "italic": false,
      "alignment": "left",
      "first_line_indent_cm": 0.0,
      "left_indent_cm": 0.85,
      "hanging_indent_cm": 0.85,
      "line_spacing_mode": "single",
      "line_spacing_pt": 1.0,
      "space_before_pt": 0.0,
      "space_after_pt": 4.0,
      "widow_control": true
    },
    "caption": {
      "font_cn": "宋体",
      "font_en": "Times New Roman",
      "size_pt": 10.5,
      "bold": false,
      "italic": false,
      "alignment": "center",
      "first_line_indent_cm": 0.0,
      "left_indent_cm": 0.0,
      "hanging_indent_cm": 0.0,
      "line_spacing_mode": "exact",
      "line_spacing_pt": 20.0,
      "space_before_pt": 6.0,
      "space_after_pt": 6.0
    }
  },
  "heading_detection": {
    "front_matter_titles": [
      "原创性声明",
      "学位论文版权使用授权书",
      "声明",
      "摘要",
      "Abstract",
      "ABSTRACT",
      "目录",
      "Contents",
      "参考文献",
      "致谢",
      "附录"
    ],
    "numbered_heading_patterns": [
      {"pattern": "^\\s*第[一二三四五六七八九十百千万0-9]+章", "level": 1},
      {"pattern": "^\\s*\\d+\\.\\d+\\s+", "level": 2},
      {"pattern": "^\\s*\\d+\\.\\d+\\.\\d+\\s+", "level": 3}
    ]
  },
  "auto_heading_numbering": false,
  "normal_table_border_mode": "three_line",
  "table_border_width_pt": 0.5,
  "three_line_header_width_pt": 1.5,
  "three_line_bottom_width_pt": 0.75,
  "normal_table_layout_mode": "smart",
  "normal_table_smart_levels": 4,
  "normal_table_line_spacing_mode": "single",
  "normal_table_repeat_header": true,
  "normal_table_cant_split_rows": true,
  "table_text_font_cn": "宋体",
  "table_text_font_en": "Times New Roman",
  "table_text_size_pt": 10.5,
  "table_text_alignment": "left",
  "table_number_alignment": "center"
}
